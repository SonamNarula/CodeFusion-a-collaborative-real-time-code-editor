{
  "name": "codefusion",
  "version": "0.1.0",
  "private": true,
  "description": "A premium authenticated real-time collaborative code editor built with React, Express, SQLite, and Socket.IO.",
  "keywords": [
    "collaborative-code-editor",
    "realtime",
    "socket.io",
    "react",
    "express",
    "sqlite",
    "pair-programming",
    "technical-interviews"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SonamNarula/CodeFusion-a-collaborative-real-time-code-editor.git"
  },
  "proxy": "http://localhost:5050",
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.3",
    "@testing-library/user-event": "^13.5.0",
    "codemirror": "^5.65.2",
    "better-sqlite3": "^11.7.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.17.3",
    "react": "^17.0.2",
    "react-avatar": "^4.0.0",
    "react-dom": "^17.0.2",
    "react-hot-toast": "^2.2.0",
    "react-router-dom": "^6.2.1",
    "react-scripts": "5.0.0",
    "socket.io": "^4.4.1",
    "socket.io-client": "^4.4.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^8.3.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start:front": "react-scripts start",
    "start": "npm run build && NODE_ENV=production npm run server:prod",
    "build": "react-scripts build",
    "server:dev": "nodemon server.js",
    "server:prod": "node server.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "nodemon": "^2.0.15"
  }
}